{
  "name": "omp-verifier",
  "version": "0.13.0",
  "description": "OMP advisor-triggered programmatic verification with evidence-first check results.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/klondikemarlen/omp-verifier#readme",
  "bugs": {
    "url": "https://github.com/klondikemarlen/omp-verifier/issues"
  },
  "qna": false,
  "keywords": ["omp", "oh-my-pi", "plugin", "advisor", "watchdog", "verification"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klondikemarlen/omp-verifier.git"
  },
  "imports": {
    "#root/*": "./*"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "COMMITTING.md",
    "docs/",
    "LICENSE",
    "README.md",
    "WATCHDOG.md",
    "bin/",
    "omp-plugin/"
  ],
  "bin": {
    "omp-verifier": "./bin/omp-verifier.js"
  },
  "omp": {
    "extensions": ["./omp-plugin/index.js"],
    "verifications": [{
      "id": "verifier:project-lint",
      "label": "Project Lint",
      "description": "Discover and run existing project linters for JavaScript/TypeScript, Ruby, Go, Python, and Shell without provisioning tools.",
      "entry": "./omp-plugin/project-lint-check.mjs",
      "timeoutMs": 120000,
      "pathTriggers": [
        "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs", "**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts", "**/*.vue",
        "**/*.rb", "**/*.rake", "**/*.gemspec", "**/*.go", "**/*.py", "**/*.pyi", "**/*.sh", "**/*.bash", "**/*.ksh",
        "**/package.json", "**/Gemfile", "**/Rakefile", "**/go.mod",
        "**/eslint.config.*", "**/.eslintrc", "**/.eslintrc.*", "**/.rubocop.yml", "**/.golangci.yml", "**/.golangci.yaml",
        "**/ruff.toml", "**/.ruff.toml", "**/pyproject.toml", "**/.shellcheckrc", "**/.omp-verifier.json"
      ]
    }],
    "lifecycle": {
      "uninstall": "./omp-plugin/index.js"
    }
  },
  "pi": {
    "extensions": ["./omp-plugin/index.js"],
    "lifecycle": {
      "uninstall": "./omp-plugin/index.js"
    }
  },
  "scripts": {
    "check": "node --check bin/omp-verifier.js && node --check omp-plugin/index.js && node --check omp-plugin/reporters.js && node --check omp-plugin/verifications.js && node --check omp-plugin/project-lint-check.mjs && node --check test/verifier-plugin.test.js",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test test/*.test.js",
    "release:check": "npm run lint && npm run check && npm test",
    "reinstall": "omp plugin uninstall omp-verifier; omp plugin install \"github:klondikemarlen/omp-verifier#$(git rev-parse HEAD)\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}
