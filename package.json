{
  "name": "omp-verifier",
  "version": "0.10.20",
  "description": "OMP advisor-triggered programmatic verification with evidence-first check results.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/klondikemarlen/omp-verifier#readme",
  "bugs": {
    "url": "https://github.com/klondikemarlen/omp-verifier/issues"
  },
  "qna": false,
  "keywords": ["omp", "oh-my-pi", "plugin", "advisor", "watchdog", "verification"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klondikemarlen/omp-verifier.git"
  },
  "imports": {
    "#root/*": "./*"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "COMMITTING.md",
    "docs/",
    "LICENSE",
    "README.md",
    "WATCHDOG.md",
    "bin/",
    "omp-plugin/"
  ],
  "bin": {
    "omp-verifier": "./bin/omp-verifier.js"
  },
  "omp": {
    "extensions": ["./omp-plugin/index.js"],
    "lifecycle": {
      "uninstall": "./omp-plugin/index.js"
    }
  },
  "pi": {
    "extensions": ["./omp-plugin/index.js"],
    "lifecycle": {
      "uninstall": "./omp-plugin/index.js"
    }
  },
  "scripts": {
    "check": "node --check bin/omp-verifier.js && node --check omp-plugin/index.js && node --check omp-plugin/reporters.js && node --check omp-plugin/verifications.js && node --check test/verifier-plugin.test.js",
    "test": "node --test test/*.test.js",
    "release:check": "npm run check && npm test",
    "reinstall": "omp plugin uninstall omp-verifier; omp plugin install \"github:klondikemarlen/omp-verifier#$(git rev-parse HEAD)\""
  }
}
